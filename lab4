from abc import ABC, abstractmethod

class DeliveryStrategy(ABC):
    @abstractmethod
    def calculate_cost(self, distance: float, weight: float) -> float:
        pass


class CourierDelivery(DeliveryStrategy):
    def calculate_cost(self, distance: float, weight: float) -> float:

        base_cost = 5.0
        per_km = 0.5
        per_kg = 1.0
        return base_cost + (distance * per_km) + (weight * per_kg)


class PostalDelivery(DeliveryStrategy):
    def calculate_cost(self, distance: float, weight: float) -> float:

        base_cost = 3.0
        insurance = weight * 0.7
        return base_cost + insurance


class DroneDelivery(DeliveryStrategy):
    def calculate_cost(self, distance: float, weight: float) -> float:

        if weight > 5:
            return float('inf')

        base_cost = 10.0
        per_km = 0.2
        return base_cost + (distance * per_km)


class DeliveryContext:
    def __init__(self, strategy: DeliveryStrategy):
        self._strategy = strategy

    def set_strategy(self, strategy: DeliveryStrategy):
        self._strategy = strategy

    def calculate_delivery_cost(self, distance: float, weight: float) -> float:
        return self._strategy.calculate_cost(distance, weight)


if __name__ == "__main__":

    context = DeliveryContext(PostalDelivery())

    while True:
        print("\nВыберите способ доставки:")
        print("1. Курьерская доставка")
        print("2. Почта")
        print("3. Дроном")
        print("4. Выход")

        choice = input("Ваш выбор: ")

        if choice == '4':
            break

        try:
            distance = float(input("Введите расстояние доставки (км): "))
            weight = float(input("Введите вес посылки (кг): "))

            if choice == '1':
                context.set_strategy(CourierDelivery())
            elif choice == '2':
                context.set_strategy(PostalDelivery())
            elif choice == '3':
                context.set_strategy(DroneDelivery())
            else:
                print("Неверный выбор, попробуйте снова")
                continue

            cost = context.calculate_delivery_cost(distance, weight)
            if cost == float('inf'):
                print("Доставка невозможна: слишком тяжелый груз для дрона")
            else:
                print(f"Стоимость доставки: ${cost:.2f}")

        except ValueError:
            print("Ошибка: введите числовые значения для расстояния и веса")
